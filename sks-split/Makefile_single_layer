F77 = h5pfc
F90 = h5pfc

ARCH ?= x86_64
ODIR = objects/$(ARCH)
BDIR = ../bin/$(ARCH)

FFLAGS = -O2
FFLAGS_DEBUG = -g -O0
F90FLAGS = $(FFLAGS)
F90FLAGS_DEBUG = $(FFLAGS_DEBUG)

VERA_LIB_OBJS = $(ODIR)/vera_util.o $(ODIR)/vera_jacobi.o
VERA_LIB_OBJS_DEBUG = $(VERA_LIB_OBJS:.o=.dbg.o)
VERA_LIB_OBJS_DFAST = $(VERA_LIB_OBJS:.o=.dfast.o)

all: dir lib tensor_phase c6x6to81_dens c6x6to81_dens_stream cijkl2sav

dir:
	mkdir -p $(ODIR) $(BDIR)

clean:
	rm -rf $(ODIR)/*.o $(ODIR)/*.dbg.o $(ODIR)/*.dfast.o $(ODIR)/*.a

lib: $(ODIR)/libvera.a $(ODIR)/libvera.dbg.a $(ODIR)/libvera.dfast.a

$(ODIR)/libvera.a: $(VERA_LIB_OBJS)
	ar rv $@ $^

$(ODIR)/libvera.dbg.a: $(VERA_LIB_OBJS_DEBUG)
	ar rv $@ $^

$(ODIR)/libvera.dfast.a: $(VERA_LIB_OBJS_DFAST)
	ar rv $@ $^

tensor_phase: $(ODIR)/tensor_phase.o $(ODIR)/libvera.a
	$(F77) $< -L$(ODIR) -lvera -o $(BDIR)/tensor_phase

c6x6to81_dens: c6x6to81_dens.F $(ODIR)/libvera.a
	$(F77) $(FFLAGS) -c $< -o $(ODIR)/c6x6to81_dens.o
	$(F77) $(ODIR)/c6x6to81_dens.o -L$(ODIR) -lvera -o $(BDIR)/c6x6to81_dens

c6x6to81_dens_stream: c6x6to81_dens.F $(ODIR)/libvera.a
	$(F77) -DSTREAM $(FFLAGS) -c $< -o $(ODIR)/c6x6to81_dens_stream.o
	$(F77) $(ODIR)/c6x6to81_dens_stream.o -L$(ODIR) -lvera -o $(BDIR)/c6x6to81_dens_stream

cijkl2sav: cijkl2sav.f90 $(ODIR)/libvera.a
	$(F90) $(F90FLAGS) -c $< -o $(ODIR)/cijkl2sav.o
	$(F90) $(ODIR)/cijkl2sav.o -L$(ODIR) -lvera -o $(BDIR)/cijkl2sav

# Pattern rules WITHOUT leading slash
$(ODIR)/%.o: %.f
	$(F77) $(FFLAGS) -c $< -o $@

$(ODIR)/%.o: %.F
	$(F77) $(FFLAGS) -c $< -o $@

$(ODIR)/%.o: %.f90
	$(F90) $(F90FLAGS) -c $< -o $@

$(ODIR)/%.dbg.o: %.f
	$(F77) $(FFLAGS_DEBUG) -c $< -o $@

$(ODIR)/%.dbg.o: %.f90
	$(F90) $(F90FLAGS_DEBUG) -c $< -o $@

$(ODIR)/%.dfast.o: %.f
	$(F77) $(FFLAGS) -c $< -o $@

$(ODIR)/%.dfast.o: %.f90
	$(F90) $(F90FLAGS) -c $< -o $@
